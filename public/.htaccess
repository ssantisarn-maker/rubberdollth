# LiteSpeed & Apache Configuration for RUBBER DOLL THAILAND
<IfModule mod_headers.c>
    # Disable caching for HTML and JSON so code updates are instant
    <FilesMatch "\.(html|htm|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    # Long cache for hashed immutable assets (JS, CSS, Images)
    <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|ico|svg|woff2)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
</IfModule>

# Single Page Application (SPA) Rewrite Rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
